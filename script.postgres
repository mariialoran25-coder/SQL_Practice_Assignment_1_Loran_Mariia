create schema university;
set search_path to university, public;

create table student (
   id integer primary key,
   full_name varchar(100) not null,
   email varchar(100),
   phone varchar(20),
   date_of_birth date,
   country varchar(100),
   financed_at varchar(100)
);

create table teacher (
   id integer primary key,
   full_name text not null,
   email varchar(100),
   phone varchar(20),
   date_of_birth date,
   country varchar(100),
   salary integer
);

create table courses (
    id integer primary key,
    course_name varchar(150) not null,
    teacher_id integer,
    description text,
    status varchar(20),
    foreign key (teacher_id) references teacher(id)

);

create table enrollments (
  id integer primary key,
  student_id integer,
  course_id integer,
  class_hours integer,
  foreign key (student_id) references  student(id),
  foreign key (course_id) references  courses(id)
);


create table grades (
   id bigint primary key,
   student_id integer,
   course_id integer,
    score integer,
    foreign key (student_id) references  student(id),
    foreign key (course_id) references  courses(id)
);



WITH student_study AS (
    SELECT
        s.full_name AS student_name,
        t.full_name AS teacher_name,
        s.financed_at AS financedBy,
        c.course_name As course ,
        SUM(e.class_hours) AS total_hours,
        AVG(g.score) AS avg_score
    FROM "Enrollments" e
    JOIN "Student" s ON e.student_id = s.id
    JOIN "Courses" c ON e.course_id = c.id
    JOIN "Teacher" t ON c.teacher_id = t.id
    JOIN "Grades" g ON s.id = g.student_id AND c.id = g.course_id
    WHERE c.status = 'active'
    GROUP BY s.full_name,t.full_name,s.financed_at, c.course_name

)
SELECT
    student_name,
    teacher_name,
    course,
    financedBy,
    total_hours,
    avg_score
FROM student_study
WHERE avg_score > 8.0 And total_hours > 80

UNION ALL
SELECT
    student_name,
    teacher_name,
    course,
    financedBy,
    total_hours,
    avg_score
FROM  student_study
WHERE avg_score <= 8.0 And total_hours > 80
ORDER BY student_name, avg_score DESC;












