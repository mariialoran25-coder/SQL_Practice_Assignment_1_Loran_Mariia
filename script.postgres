insert into "Courses" ("id", "course_name", "teacher_id", "description", "status") values
(1, 'introduction to database systems', 14, 'explore relational databases, sql fundamentals, and database design principles including normalization and entity-relationship modeling. students will implement real-world database solutions using postgresql or mysql.', 'completed'),
(2, 'linear algebra ii', 7, 'advanced study of vector spaces, linear transformations, eigenvalues, and diagonalization with applications to computer graphics and scientific computing. emphasis on rigorous proofs and computational techniques.', 'completed'),
(3, 'quantum mechanics i', 11, 'foundational course covering wave-particle duality, schrödinger equation, and quantum superposition with mathematical formalism and physical interpretation. laboratory experiments and simulations reinforce theoretical concepts.', 'completed'),
(4, 'microeconomics', 18, 'study of individual consumer and firm behavior, market structures, and price determination under perfect and imperfect competition. applications include welfare economics and policy analysis.', 'active'),
(5, 'medieval european history', 8, 'comprehensive examination of feudalism, religious institutions, and cultural developments spanning the fifth through fifteenth centuries. focus on primary sources and historiographical debates regarding social transformation.', 'archived'),
(6, 'molecular biology', 8, 'investigation of gene expression, protein synthesis, dna replication, and cellular regulation at the molecular level. includes laboratory techniques in genetic engineering and bioinformatics.', 'active'),
(7, 'constitutional law', 4, 'analysis of fundamental constitutional principles, separation of powers, and individual rights protections through landmark judicial decisions and constitutional interpretation methodologies.', 'completed'),
(8, 'syntax and morphology', 11, 'examination of linguistic structures governing sentence formation and word formation processes across diverse languages, employing generative grammar frameworks and comparative analysis.', 'draft'),
(9, 'thermodynamics and heat transfer', 14, 'study of energy conversion, heat flow mechanisms, and entropy in mechanical systems with applications to engines, refrigeration, and renewable energy. combines theoretical principles with engineering design problems.', 'active'),
(10, 'cognitive psychology', 10, 'exploration of memory, attention, perception, and decision-making processes through empirical research and cognitive models. includes discussion of neuroscientific correlates and practical applications in human-computer interaction.', 'active'),
(11, 'object-oriented programming', 16, 'master class and encapsulation, inheritance, polymorphism, and design patterns using languages like java or python. emphasis on writing maintainable, scalable code for large software projects.', 'draft'),
(12, 'multivariable calculus', 3, 'extension of single-variable calculus to functions of multiple variables, including partial derivatives, multiple integration, and vector calculus. applications in optimization and physics.', 'active'),
(13, 'classical mechanics', 10, 'rigorous treatment of newton''s laws, conservation principles, rotational dynamics, and oscillatory motion with emphasis on lagrangian and hamiltonian formulations for complex systems.', 'draft'),
(14, 'macroeconomics', 4, 'analysis of aggregate economic phenomena including employment, inflation, gdp growth, and monetary/fiscal policy mechanisms. examines competing macroeconomic theories and their policy implications.', 'completed'),
(15, 'ancient civilizations and cultures', 15, 'survey of mesopotamian, egyptian, greek, and roman civilizations examining technological innovation, political structures, and intellectual achievements that shaped western thought.', 'active'),
(16, 'cell and developmental biology', 1, 'study of cell structure, division mechanisms, organelle function, and embryonic development from molecular signals to organismal patterns. laboratory work includes microscopy and experimental embryology.', 'archived'),
(17, 'criminal procedure', 1, 'detailed examination of investigative procedures, arrest and search protocols, interrogation rights, and trial processes within constitutional constraints and federal/state statutes.', 'active'),
(18, 'semantics and pragmatics', 4, 'analysis of meaning in language systems including reference, sense relations, and truth conditions alongside contextual interpretation and communication principles. incorporates cognitive and experimental approaches.', 'completed'),
(19, 'structural analysis and design', 1, 'application of mechanics principles to analyze internal forces in beams, frames, and trusses with design of structural elements for safety and efficiency. includes computer-aided design applications.', 'draft'),
(20, 'abnormal psychology', 13, 'comprehensive study of psychological disorders including anxiety, mood disorders, schizophrenia, and personality disorders through diagnostic criteria, etiology, and evidence-based treatments.', 'active'),
(21, 'algorithms and data structures', 17, 'systematic study of fundamental algorithms including sorting, searching, and graph traversal with analysis of time and space complexity. implementation using modern programming languages and big o notation.', 'active'),
(22, 'abstract algebra', 16, 'rigorous mathematical investigation of groups, rings, and fields with focus on algebraic structures and their properties. includes applications to cryptography and coding theory.', 'active'),
(23, 'electromagnetism', 14, 'comprehensive treatment of electric fields, magnetic fields, and their interactions through maxwell''s equations with applications to electromagnetic waves, circuits, and relativistic effects.', 'active'),
(24, 'international trade and finance', 4, 'study of comparative advantage, trade flows, exchange rates, and capital flows between nations with analysis of tariff policy and global financial institutions.', 'active'),
(25, 'renaissance and enlightenment', 11, 'exploration of intellectual and cultural transformation in europe from the fourteenth through eighteenth centuries including humanism, scientific revolution, and philosophical movements that redefined knowledge and society.', 'active'),
(26, 'pharmacology and drug development', 11, 'study of drug mechanisms of action, pharmacokinetics, and pharmacodynamics with focus on therapeutic applications and adverse effects. covers drug discovery processes, clinical trials, and regulatory frameworks governing pharmaceutical approval.', 'active'),
(27, 'network security and cryptography', 5, 'comprehensive examination of encryption algorithms, network protocols, threat models, and defensive strategies against cyberattacks. students implement cryptographic systems and conduct security audits on real-world applications.', 'active'),
(28, 'probability theory and mathematical statistics', 12, 'rigorous foundations of probability, random variables, and statistical inference including hypothesis testing and confidence intervals. applications span data analysis, risk assessment, and machine learning.', 'archived'),
(29, 'kant and german idealism', 13, 'critical analysis of immanuel kant''s epistemology, metaphysics, and ethics alongside successor philosophers like hegel and fichte who shaped continental philosophy. examination of primary texts and interpretive debates about transcendental idealism.', 'active'),
(30, 'evolutionary biology and population genetics', 7, 'investigation of evolutionary mechanisms including natural selection, genetic drift, and mutation with population-level analysis of allele frequencies and speciation. laboratory work includes phylogenetic reconstruction and population modeling simulations.', 'active');




